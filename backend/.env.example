# Environment Configuration for Index P (Melbourne CBD Pedestrian Platform)
# Copy this file to .env and configure environment variables on Render / Supabase / Modal.

# Render / Flask Settings
FLASK_ENV=production
SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_SECRET_KEY=change-this-to-a-secure-random-jwt-key
DATA_TYPE=real

# Modal.com Serverless Offloading Configuration
# When configured, Render delegates heavy ML predictions to Modal to prevent Render free-tier timeouts/overloads.
# 1. Deploy Modal app: modal deploy backend/scripts/modal_app.py
# 2. Set MODAL_API_URL in Render Dashboard to your Modal endpoint URL:
MODAL_API_URL=https://your-modal-username--melbourne-cbd-crowd-ml-predict-endpoint.modal.run

# Supabase Credentials (Database & Persistence)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
# How many days of recent real hourly counts to pull from Supabase when the
# local hourly_counts.csv is absent (must cover 28 days of lag features).
SUPABASE_COUNTS_DAYS=45

# Upstash Redis Cache (Optional for fast caching)
UPSTASH_REDIS_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-redis-token
CACHE_TTL_SECONDS=60
