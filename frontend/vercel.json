{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://melbourne-cbd-crowd-backend.onrender.com/api/:path*" },
    { "source": "/static/:path*", "destination": "/static/:path*" },
    { "source": "/", "destination": "/templates/map.html" },
    { "source": "/forecast", "destination": "/templates/index.html" },
    { "source": "/map", "destination": "/templates/map.html" },
    { "source": "/predict", "destination": "/templates/predict.html" },
    { "source": "/models", "destination": "/templates/models.html" },
    { "source": "/features", "destination": "/templates/features.html" },
    { "source": "/help", "destination": "/templates/help.html" }
  ]
}
